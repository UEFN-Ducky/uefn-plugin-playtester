{
  "id": "playtester",
  "kind": "plugin",
  "version": "1.1.7",
  "label": "Play Tester",
  "description": "Plays the live Fortnite client with Jev vision and world coordinates: sees each frame, knows where the player and the target are (even behind a building or upstairs), decides moves in about a second, and shows every key, mouse turn and Jev decision live in its tab. Chat agents start in-game play tests with one tool call. Jev answers with your TypeSafe key or through Ducky AI; a gateway vision model works too.",
  "min_app_version": "1.2.390",
  "default_enabled": false,
  "data_sharing": false,
  "secret_keys": [],
  "contributes": {
    "agent.tools": {
      "category": "playtester",
      "intent_pattern": "\\b(play ?test(s|ing|er)?|play-?test\\w*|in[- ]game|ingame|fortnite client|test (it |this |that |my |the )?(island|map|level|game)|walk (the player|to)|move the (player|character)|jev)\\b",
      "plan_tools": [
        "playtester_status",
        "playtester_get_run",
        "playtester_list_runs",
        "playtester_frame",
        "playtester_wait",
        "playtester_where",
        "playtester_lessons",
        "playtester_map"
      ]
    },
    "ui.panels": [
      {
        "id": "live",
        "title": "Play Tester",
        "icon": "\ud83c\udfae",
        "entry": "ui/index.html"
      }
    ],
    "header.buttons": [
      {
        "id": "live",
        "title": "Play Tester",
        "icon": "\ud83c\udfae",
        "action": "panel:live",
        "order": 58
      }
    ],
    "settings.tabs": [
      {
        "id": "PlayTester",
        "label": "Play Tester",
        "icon": "\ud83c\udfae",
        "ui": "sections"
      }
    ],
    "settings.sections": [
      {
        "tab": "PlayTester",
        "id": "pilot",
        "title": "Jev pilot",
        "description": "Play Tester asks Jev about every Fortnite frame and moves the player from its answers. Jev runs on your TypeSafe key (Settings → LLMs) or through Ducky AI.",
        "order": 10,
        "properties": [
          {
            "id": "brain",
            "type": "select",
            "default": "auto",
            "label": "Who answers",
            "description": "Auto uses your TypeSafe key when one is saved, else Jev through Ducky AI when you are signed in, else the gateway model below (or your default model).",
            "options": [
              {
                "value": "auto",
                "label": "Auto"
              },
              {
                "value": "typesafe",
                "label": "Jev with my TypeSafe key"
              },
              {
                "value": "ducky_ai",
                "label": "Jev through Ducky AI"
              },
              {
                "value": "gateway",
                "label": "A gateway model (no box)"
              }
            ]
          },
          {
            "id": "gateway",
            "type": "string",
            "default": "",
            "label": "Gateway",
            "description": "The gateway id for the gateway brain, for example openai or anthropic. Empty uses your default model."
          },
          {
            "id": "gateway_model",
            "type": "string",
            "default": "",
            "label": "Gateway model",
            "description": "A model on that gateway that can see pictures, for example gpt-6-luna."
          },
          {
            "id": "model",
            "type": "select",
            "default": "jev-1.14.0",
            "label": "Jev model",
            "description": "Finding things with a box needs jev-1.14.0 or jev-preview; older models fall back to left / center / right.",
            "options": [
              {
                "value": "jev-1.14.0",
                "label": "jev-1.14.0 (box, recommended)"
              },
              {
                "value": "jev-preview",
                "label": "jev-preview (newest)"
              },
              {
                "value": "jev-latest",
                "label": "jev-latest"
              },
              {
                "value": "jev-1.13.0",
                "label": "jev-1.13.0 (no box)"
              }
            ]
          },
          {
            "id": "look_counts",
            "type": "string",
            "default": "2500",
            "label": "Mouse counts for a 90\u00b0 turn",
            "description": "How far the mouse moves to turn the camera 90\u00b0 at your Fortnite sensitivity. playtester_calibrate measures it and saves it here."
          },
          {
            "id": "max_steps",
            "type": "select",
            "default": "60",
            "label": "Most steps in one run",
            "description": "A run stops after this many steps (or 5 minutes).",
            "options": [
              {
                "value": "30",
                "label": "30"
              },
              {
                "value": "60",
                "label": "60"
              },
              {
                "value": "120",
                "label": "120"
              }
            ]
          },
          {
            "id": "confidence",
            "type": "select",
            "default": "0.6",
            "label": "Trust Jev from",
            "description": "Answers below this are treated as unsure (the TypeSafe video used 0.65).",
            "options": [
              {
                "value": "0.5",
                "label": "50%"
              },
              {
                "value": "0.6",
                "label": "60%"
              },
              {
                "value": "0.7",
                "label": "70%"
              },
              {
                "value": "0.8",
                "label": "80%"
              }
            ]
          },
          {
            "id": "image_size",
            "type": "select",
            "default": "1024",
            "label": "Frame size sent to Jev",
            "description": "Longest side in pixels. Bigger sees small things better; smaller is faster.",
            "options": [
              {
                "value": "768",
                "label": "768 px (fastest)"
              },
              {
                "value": "1024",
                "label": "1024 px"
              },
              {
                "value": "1280",
                "label": "1280 px"
              },
              {
                "value": "1568",
                "label": "1568 px (most detail)"
              }
            ]
          },
          {
            "id": "click_focus",
            "type": "boolean",
            "default": true,
            "label": "Click to bring Fortnite to the front",
            "description": "When Windows won't switch to Fortnite, click once: on its title bar when windowed, a right click (aim) in the middle when fullscreen. Your cursor goes back where it was. Never while Fortnite is loading."
          },
          {
            "id": "smooth_walk",
            "type": "boolean",
            "default": true,
            "label": "Keep walking while Jev thinks",
            "description": "Walk keys stay held between steps and turns happen while walking, so the player doesn't stop and start. Keys come up the moment Fortnite loses focus, Stop is pressed or no decision arrives for 2.5 s."
          }
        ]
      }
    ],
    "automations": {
      "nodes": [
        {
          "id": "playtester.status",
          "label": "Play Tester status",
          "group": "Play Tester",
          "description": "Is Fortnite open and in play mode, is the Jev key saved, is a run playing.",
          "config_fields": [],
          "outputs": [
            {
              "id": "ready",
              "label": "Ready",
              "type": "boolean"
            },
            {
              "id": "next",
              "label": "What to do",
              "type": "string"
            }
          ]
        },
        {
          "id": "playtester.run",
          "label": "Play test a goal",
          "group": "Play Tester",
          "description": "Jev drives the Fortnite player toward the goal and reports success, steps and time.",
          "config_fields": [
            {
              "id": "goal",
              "label": "Goal",
              "type": "textarea"
            },
            {
              "id": "target",
              "label": "Target to walk to",
              "type": "string"
            },
            {
              "id": "target_actor",
              "label": "Target actor label (world position)",
              "type": "string"
            },
            {
              "id": "target_xyz",
              "label": "Or target x,y,z (cm)",
              "type": "string"
            },
            {
              "id": "success",
              "label": "Success check (yes/no question)",
              "type": "string"
            },
            {
              "id": "success_print",
              "label": "Or passes when Verse prints",
              "type": "string"
            },
            {
              "id": "interact",
              "label": "Use the target (hold E)",
              "type": "boolean"
            },
            {
              "id": "max_steps",
              "label": "Most steps",
              "type": "number"
            },
            {
              "id": "dry_run",
              "label": "Dry run (watch, no keys)",
              "type": "boolean"
            }
          ],
          "inputs": [
            {
              "id": "goal",
              "label": "Goal",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "status",
              "label": "Result",
              "type": "string"
            },
            {
              "id": "steps",
              "label": "Steps",
              "type": "number"
            },
            {
              "id": "seconds",
              "label": "Seconds",
              "type": "number"
            },
            {
              "id": "summary",
              "label": "Summary",
              "type": "string"
            },
            {
              "id": "frame",
              "label": "Last frame",
              "type": "string"
            }
          ]
        },
        {
          "id": "playtester.check",
          "label": "Jev looks at the game",
          "group": "Play Tester",
          "description": "Ask Jev your own questions about the current Fortnite frame (call it `frame`).",
          "config_fields": [
            {
              "id": "questions",
              "label": "Questions JSON",
              "type": "textarea"
            }
          ],
          "inputs": [
            {
              "id": "questions",
              "label": "Questions",
              "type": "json"
            }
          ],
          "outputs": [
            {
              "id": "answers",
              "label": "Answers",
              "type": "json"
            },
            {
              "id": "frame",
              "label": "Frame",
              "type": "string"
            }
          ]
        },
        {
          "id": "playtester.press",
          "label": "Press keys in game",
          "group": "Play Tester",
          "description": "Hold keys in the Fortnite client (W, A, S, D, SPACE, E\u2026).",
          "config_fields": [
            {
              "id": "keys",
              "label": "Keys (W+A, SPACE, E)",
              "type": "string"
            },
            {
              "id": "seconds",
              "label": "Seconds",
              "type": "number"
            }
          ],
          "outputs": [
            {
              "id": "frame",
              "label": "Frame after",
              "type": "string"
            }
          ]
        },
        {
          "id": "playtester.look",
          "label": "Turn the camera",
          "group": "Play Tester",
          "description": "Turn the Fortnite camera by degrees (right and down are positive).",
          "config_fields": [
            {
              "id": "dx_degrees",
              "label": "Turn right (degrees)",
              "type": "number"
            },
            {
              "id": "dy_degrees",
              "label": "Look down (degrees)",
              "type": "number"
            }
          ],
          "outputs": [
            {
              "id": "frame",
              "label": "Frame after",
              "type": "string"
            }
          ]
        },
        {
          "id": "playtester.stop",
          "label": "Stop the play test",
          "group": "Play Tester",
          "description": "Stop the running play test; every key is released.",
          "config_fields": [
            {
              "id": "run_id",
              "label": "Run id (empty = the running one)",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "stopped",
              "label": "Stopped",
              "type": "boolean"
            }
          ]
        },
        {
          "id": "playtester.where",
          "label": "Where is the player",
          "group": "Play Tester",
          "description": "The player's world position from the beacon, and how far and which way a target is.",
          "config_fields": [
            {
              "id": "target_actor",
              "label": "Target actor label",
              "type": "string"
            },
            {
              "id": "target_xyz",
              "label": "Or target x,y,z (cm)",
              "type": "string"
            }
          ],
          "outputs": [
            {
              "id": "say",
              "label": "Where the target is",
              "type": "string"
            },
            {
              "id": "distance_m",
              "label": "Distance (m)",
              "type": "number"
            }
          ]
        },
        {
          "id": "playtester.lessons",
          "label": "What past play tests taught",
          "group": "Play Tester",
          "description": "Success rate, what blocked runs and tips for a target, from past runs on this island.",
          "config_fields": [
            {
              "id": "target",
              "label": "Target (empty = all)",
              "type": "string"
            },
            {
              "id": "limit",
              "label": "Recent runs to list",
              "type": "number"
            }
          ],
          "outputs": [
            {
              "id": "summary",
              "label": "Tips",
              "type": "string"
            },
            {
              "id": "success_rate",
              "label": "Success rate",
              "type": "number"
            }
          ]
        },
        {
          "id": "playtester.map",
          "label": "Read the island layout",
          "group": "Play Tester",
          "description": "Every device's label and position from UEFN, kept for play tests (landmarks, targets by label).",
          "config_fields": [
            {
              "id": "refresh",
              "label": "Read it again from UEFN",
              "type": "boolean"
            }
          ],
          "outputs": [
            {
              "id": "count",
              "label": "Devices",
              "type": "number"
            },
            {
              "id": "summary",
              "label": "Summary",
              "type": "string"
            }
          ]
        }
      ],
      "templates": [
        {
          "id": "playtester-goal",
          "label": "Play test a goal",
          "category": "Play Tester",
          "icon": "\ud83c\udfae",
          "description": "Chat start \u2192 Agent \u2192 Jev plays the goal in Fortnite \u2192 Finish. Set the goal, target and success check on the Play test node.",
          "requires_plugins": [
            "playtester"
          ],
          "graph": {
            "nodes": [
              {
                "id": "s",
                "type": "start.chat",
                "x": 0,
                "y": 0,
                "config": {},
                "label": "Chat"
              },
              {
                "id": "a",
                "type": "pipeline.agent",
                "x": 220,
                "y": 0,
                "config": {
                  "title": "Plan the test"
                },
                "label": "Agent"
              },
              {
                "id": "n",
                "type": "playtester.run",
                "x": 440,
                "y": 0,
                "config": {
                  "goal": "",
                  "target": "",
                  "success": "",
                  "interact": false,
                  "dry_run": false
                },
                "label": "Play test"
              },
              {
                "id": "f",
                "type": "pipeline.finish",
                "x": 660,
                "y": 0,
                "config": {
                  "message": "Play test finished."
                },
                "label": "Finish"
              }
            ],
            "edges": [
              {
                "source": "s",
                "target": "a",
                "kind": "main"
              },
              {
                "source": "a",
                "target": "n",
                "kind": "main"
              },
              {
                "source": "n",
                "target": "f",
                "kind": "main"
              }
            ]
          }
        }
      ]
    },
    "verse.templates": [
      {
        "id": "playtester_beacon",
        "name": "Play Tester beacon",
        "icon": "\ud83d\udccd",
        "description": "Prints each player's position and facing a few times a second so Play Tester can steer by world coordinates (behind buildings, other floors). Place one in the island.",
        "folder": "PlayTester",
        "files": [
          {
            "path": "playtester_beacon_device.verse",
            "file": "templates/playtester_beacon_device.verse"
          }
        ],
        "order": 90
      }
    ]
  },
  "backend": {
    "entry": "backend",
    "register": "register"
  }
}
